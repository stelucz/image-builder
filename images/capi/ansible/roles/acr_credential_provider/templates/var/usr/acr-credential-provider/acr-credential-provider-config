apiVersion: kubelet.config.k8s.io/v1
kind: CredentialProviderConfig
providers:
  - name: acr-credential-provider
    matchImages: {{ acr_credential_provider_match_images }}
      defaultCacheDuration: {{ acr_credential_provider_cache_duration }}
      apiVersion: credentialprovider.kubelet.k8s.io/v1
      {% if acr_credential_provider_args | length > 0 %}
      args: {{ acr_credential_provider_args }}
      {% endif %}
